.container {
  padding-bottom: 220rpx;
  min-height: 100vh;
  background: #f5f5f5;
}

.cart-list {
  padding: 20rpx;
}

.cart-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  position: relative;
}

.checkbox {
  margin-right: 20rpx;
}

.goods-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  background: #eee;
  margin-right: 20rpx;
}

.goods-info {
  flex: 1;
  height: 160rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-title {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.goods-price-box {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.goods-price {
  color: #ff4d4f;
  font-size: 32rpx;
  font-weight: bold;
}

.stepper {
  display: flex;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
}

.step-btn {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8f8f8;
  font-size: 32rpx;
  color: #666;
}

.count {
  width: 60rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border-left: 1rpx solid #eee;
  border-right: 1rpx solid #eee;
}

.delete-btn {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 40rpx;
  height: 40rpx;
  text-align: center;
  line-height: 40rpx;
  color: #999;
  font-size: 36rpx;
}

.empty-cart {
  padding-top: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  /* 原来是 emoji（100rpx 字号 ≈ 50px）。空状态用浅灰，
     与下面的"购物车空空如也"文字形成同一层级的弱化视觉 */
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 60rpx;
}

.btn-procurement {
  width: 240rpx;
}

.footer-bar {
  position: fixed;
  bottom: 48px;
  bottom: calc(48px + env(safe-area-inset-bottom));
  left: 0;
  width: 100%;
  height: 100rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
  z-index: 99;
}

.all-select {
  display: flex;
  align-items: center;
}

.select-text {
  font-size: 28rpx;
  margin-left: 10rpx;
  color: #333;
}

.total-box {
  flex: 1;
  text-align: right;
  margin-right: 20rpx;
  font-size: 28rpx;
}

.total-price {
  color: #ff4d4f;
  font-size: 36rpx;
  font-weight: bold;
  margin-left: 10rpx;
}

.checkout-btn {
  background: #1989fa;
  color: #fff;
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}
