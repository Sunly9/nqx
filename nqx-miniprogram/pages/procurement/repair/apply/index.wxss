.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.section {
  background: #fff;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.label {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

.input-area {
  width: 100%;
  height: 200rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
}

.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
}

.image-item image {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.delete-btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 40rpx;
  font-size: 24rpx;
}

.add-btn {
  width: 160rpx;
  height: 160rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.add-btn text {
  font-size: 60rpx;
  color: #999;
  font-weight: 300;
}

.submit-btn {
  background: #07c160;
  color: #fff;
  margin-top: 50rpx;
  border-radius: 44rpx;
}

.submit-btn[disabled] {
  background: #a0e6b8;
  color: #fff;
}