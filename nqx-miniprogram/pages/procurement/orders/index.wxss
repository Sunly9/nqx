.container {
  height: 100vh;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
}

.tabs {
  background: #fff;
  display: flex;
  height: 88rpx;
  line-height: 88rpx;
  border-bottom: 1rpx solid #eee;
  flex-shrink: 0;
  width: 100%;
}

.tab-fixed {
  width: 120rpx; /* 固定宽度 */
  flex-shrink: 0;
  border-right: 1rpx solid #f0f0f0;
  box-shadow: 4rpx 0 8rpx -4rpx rgba(0,0,0,0.1); /* 右侧阴影 */
  z-index: 10;
  background: #fff;
}

.tabs-scroll {
  flex: 1;
  display: flex;
  white-space: nowrap;
  overflow: hidden;
  width: 0; /* 关键：防止 flex 子项撑开 */
}

.tab-item {
  display: inline-block; /* 配合 white-space: nowrap */
  padding: 0 30rpx; /* 左右间距 */
  text-align: center;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

/* 固定区域的 tab-item 不需要左右 padding 撑开，因为外层定了宽 */
.tab-fixed .tab-item {
  width: 100%;
  padding: 0;
}

.tab-item.active {
  color: #1989fa;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #1989fa;
}

.order-list {
  flex: 1;
  padding: 20rpx;
  box-sizing: border-box;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f9f9f9;
}

.order-no {
  color: #999;
}

.status-text {
  color: #1989fa;
}

.status-text.completed {
  color: #999;
}

.status-text.pending_payment {
  color: #ff4d4f;
}

.goods-list {
  padding: 20rpx 0;
}

.goods-item {
  display: flex;
  margin-bottom: 20rpx;
}

.goods-item:last-child {
  margin-bottom: 0;
}

.goods-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  background: #eee;
  margin-right: 20rpx;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.goods-meta {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
}

.goods-price {
  font-weight: bold;
}

.goods-count {
  color: #999;
}

.card-footer {
  border-top: 1rpx solid #f9f9f9;
  padding-top: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.total-info {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.total-price {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

.action-btns {
  display: flex;
}

.btn {
  margin-left: 20rpx;
  font-size: 24rpx;
  padding: 0 30rpx;
  line-height: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #fff;
  border: 1rpx solid #ddd;
  color: #666;
}

.btn.primary {
  background: #1989fa;
  color: #fff;
  border: none;
}

/*
 * 已提醒过的按钮：灰掉，表示"这个动作暂时不能再做了"。
 *
 * 为什么不是 disabled：
 * 还保留可点击 —— 点下去会提示"今天已经提醒过了"。
 * 如果用 disabled，用户点了没反应，会以为是页面卡了，
 * 反而比给一句明确的话更糟。
 */
.btn.is-muted {
  color: #aaa;
  border-color: #eee;
  background: #f7f8fa;
}

.empty-state {
  text-align: center;
  padding-top: 200rpx;
  color: #999;
}

.empty-icon {
  /* 原来是 emoji（80rpx 字号 ≈ 40px）；空状态图标用比正文更浅的灰，
     避免和上面列表里的真图标抢注意力 */
  margin-bottom: 20rpx;
}
 
 .review-btn-wrapper {
   position: relative;
   margin-left: 20rpx;
   display: inline-block;
 }
 
 .review-bubble {
   position: absolute;
   top: -60rpx;
   left: 50%;
   transform: translateX(-50%);
   background-color: #ff9900;
   color: #fff;
   font-size: 20rpx;
   padding: 8rpx 16rpx;
   border-radius: 8rpx;
   white-space: nowrap;
   box-shadow: 0 2rpx 8rpx rgba(255, 153, 0, 0.3);
   z-index: 10;
   display: inline-flex;
   align-items: center;
   gap: 16rpx;
 }
 
 .review-bubble::after {
   content: '';
   position: absolute;
   bottom: -8rpx;
   left: 50%;
   transform: translateX(-50%);
   border-width: 8rpx 8rpx 0;
   border-style: solid;
   border-color: #ff9900 transparent transparent;
 }
 
 .btn.review-btn {
   background: #ff4d4f;
   color: #fff;
   border: none;
   margin-left: 0;
 }
 
 .bubble-close {
   font-size: 26rpx;
   font-weight: bold;
   color: #fff;
   opacity: 0.9;
   padding: 0 8rpx;
 }
