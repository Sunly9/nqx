.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

/* Address Card */
.address-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 100rpx;
}

.addr-header {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  color: #333;
}

.addr-phone {
  margin-left: 20rpx;
  font-weight: normal;
  color: #666;
  font-size: 28rpx;
}

.addr-detail {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  padding-right: 40rpx;
}

.tag {
  background: #1989fa;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
  vertical-align: middle;
}

.addr-placeholder {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: #1989fa;
}

.icon {
  font-size: 40rpx;
  margin-right: 10rpx;
  font-weight: bold;
}

.arrow {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #ccc;
  font-size: 32rpx;
}

/* Product Card */
.product-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #f9f9f9;
  padding-bottom: 20rpx;
}

.product-item {
  display: flex;
  margin-bottom: 20rpx;
}

.prod-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 8rpx;
  background: #eee;
  margin-right: 20rpx;
}

.prod-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.prod-name {
  font-size: 28rpx;
  color: #333;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.prod-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.prod-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.prod-count {
  font-size: 26rpx;
  color: #999;
}

/* Footer */
.footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  box-sizing: border-box;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
  z-index: 100;
}

.total-box {
  font-size: 28rpx;
  color: #333;
}

.total-price {
  font-size: 36rpx;
  color: #1989fa;
  font-weight: bold;
  margin-left: 10rpx;
}

.submit-btn {
  background: linear-gradient(135deg, #1989fa 0%, #5ca9ff 100%);
  color: #fff;
  font-size: 30rpx;
  padding: 0 60rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
}