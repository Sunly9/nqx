.container {
  padding: 20rpx;
  background: #fff;
  min-height: 100vh;
}

.review-item {
  border-bottom: 1rpx solid #eee;
  padding-bottom: 30rpx;
  margin-bottom: 30rpx;
}

.review-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.review-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background-color: #f0f0f0;
}

.user-info {
  flex: 1;
}

.nickname {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 4rpx;
  display: block;
}

.stars-row {
  display: flex;
}

.star-s {
  font-size: 24rpx;
  color: #ddd;
  margin-right: 4rpx;
}

.star-s.active {
  color: #ff9900;
}

.date {
  font-size: 24rpx;
  color: #999;
}

.review-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.review-images {
  display: flex;
  flex-wrap: wrap;
}

.review-images image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.empty-reviews {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 100rpx 0;
}