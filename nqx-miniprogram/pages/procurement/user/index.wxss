.container {
  min-height: 100vh;
  background: #f8f8f8;
}

.user-card {
  padding: 60rpx 40rpx;
  display: flex;
  align-items: center;
  color: #fff;
}

.avatar-box {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  overflow: hidden;
  margin-right: 30rpx;
  background: #fff;
}

.avatar {
  width: 100%;
  height: 100%;
}

.info-box {
  flex: 1;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.role-tag {
  font-size: 24rpx;
  background: rgba(0, 0, 0, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  display: inline-block;
}

.menu-list {
  margin-top: 20rpx;
  background: #fff;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid #f5f5f5;
  font-weight: normal; /* button 默认是 bold */
}

.menu-item:active {
  background: #f9f9f9;
}

/* 客服按钮样式重置 */
.contact-btn {
  background-color: #fff !important;
  border-radius: 0;
  padding: 30rpx 40rpx !important;
  margin: 0 !important;
  line-height: inherit;
  font-size: inherit;
  color: inherit;
  width: 100% !important;
  box-sizing: border-box;
  font-weight: normal;
  /* 强制 Flex 布局 */
  display: flex !important;
  justify-content: space-between !important;
  align-items: center !important;
}

.contact-btn::after {
  border: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  margin-right: 20rpx;
  /* 图标尺寸由 nqx-icon 的 size 属性控制（18px），这里不再管 font-size */
}

.menu-arrow {
  color: #ccc;
  font-size: 28rpx;
}

.logout-btn {
  margin: 60rpx 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #fff;
  color: #ff4d4f;
  font-size: 32rpx;
  border-radius: 44rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.logout-btn:active {
  background: #f5f5f5;
}