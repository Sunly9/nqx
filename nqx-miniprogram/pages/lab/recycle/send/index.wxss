.container {
  padding: 20rpx;
  padding-bottom: 120rpx;
}

.form-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.form-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid var(--green);
}

.form-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item.column {
  flex-direction: column;
}

.label {
  width: 180rpx;
  font-size: 28rpx;
  color: #333;
  padding-top: 6rpx;
}

.input {
  flex: 1;
  font-size: 28rpx;
}

.textarea {
  flex: 1;
  height: 100rpx;
  font-size: 28rpx;
}

.picker {
  font-size: 28rpx;
  color: #333;
}

.warning-text {
  font-size: 24rpx;
  color: #ff4d4f;
  margin-top: 10rpx;
  padding-left: 180rpx;
}

.upload-box {
  width: 160rpx;
  height: 160rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #999;
  font-size: 24rpx;
}

.plus {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.footer-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 20rpx;
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

/* ============================================================================
   预计积分预览

   放在"预估重量"下面，让用户在提交前就知道"这一单大概能换多少分"。
   没有这块时，用户只能等结算后才知道结果 —— 而积分恰恰是这个平台的核心激励。
   ============================================================================ */
.points-preview {
  margin-top: 8rpx;
  padding: 20rpx 24rpx;
  background: #f0fdf4;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

.points-value {
  margin: 0 8rpx;
  font-size: 36rpx;
  font-weight: bold;
  color: #07c160;
}

.points-hint {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999999;
}
