.container {
  padding: 40rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  margin-bottom: 60rpx;
  text-align: center;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
}

.section {
  margin-bottom: 50rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  color: #333;
  padding-left: 20rpx;
  border-left: 8rpx solid #07c160;
  /* 让标题里的行内图标与文字垂直居中对齐 */
  display: flex;
  align-items: center;
}

/* 警示标题：原来是绿色左边框 + 内联的彩色警示 emoji，
   现在把语义交给图标本身（红色三角），左边框也一起转红 */
.section-title.warning-title {
  color: #ff4d4f;
  border-left-color: #ff4d4f;
}

.inline-icon {
  margin-right: 10rpx;
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card {
  background: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: flex-start;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-icon {
  /* 原来是 48rpx 的 emoji；现在由 nqx-icon 的 size="24" 决定尺寸。
     三种电池类别统一用主题绿，比原来三个彩色 emoji 更像一套设计 */
  margin-right: 30rpx;
}

.card-content {
  flex: 1;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.step-list {
  background: #fff;
  padding: 40rpx;
  border-radius: 16rpx;
}

.step-item {
  display: flex;
  margin-bottom: 30rpx;
}

.step-item:last-child {
  margin-bottom: 0;
}

.step-num {
  font-size: 32rpx;
  font-weight: bold;
  color: #07c160;
  margin-right: 20rpx;
  font-family: monospace;
}

.step-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.warning-box {
  background: #fff1f0;
  border: 1rpx solid #ffa39e;
  padding: 30rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #cf1322;
  line-height: 1.8;
}
