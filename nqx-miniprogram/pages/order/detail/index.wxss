.container {
  padding: 30rpx;
  background: #f8f8f8;
  min-height: 100vh;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

.status-card {
  padding: 40rpx;
  border-radius: 20rpx;
  color: #fff;
  margin-bottom: 30rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.status-card.pending {
  background: linear-gradient(135deg, #ffaa00, #ffcc33);
}

.status-card.processing {
  background: linear-gradient(135deg, #1989fa, #3399ff);
}

.status-card.completed {
  background: linear-gradient(135deg, #07c160, #3cc51f);
}

.status-card.cancelled {
  background: #ccc;
}

.status-text {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.status-desc {
  font-size: 26rpx;
  opacity: 0.9;
}

.section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid #1989fa;
  color: #333;
}

.info-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

.info-item:last-child {
  margin-bottom: 0;
}

.label {
  color: #999;
  width: 160rpx;
}

.value {
  flex: 1;
  text-align: right;
  color: #333;
  word-break: break-all;
}

.value.highlight {
  color: #ffaa00;
  font-weight: bold;
  font-size: 32rpx;
}

/* ============================================================================
   驳回原因区块

   用红色系区分"这是负面结果"，但不用刺眼的纯红 ——
   这里是**已定局的结果**，不是需要立即行动的危险警告，过重的红只会让人焦虑。
   ============================================================================ */
.reject-section {
  border-left: 6rpx solid #ff4d4f;
}

.reject-reason {
  padding: 16rpx 20rpx;
  background: #fff5f5;
  border-radius: 8rpx;
  color: #cf1322;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}

.reject-tip {
  margin-top: 14rpx;
  color: #999999;
  font-size: 24rpx;
  line-height: 1.5;
}
