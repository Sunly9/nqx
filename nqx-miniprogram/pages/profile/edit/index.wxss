.container {
  padding: 40rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.avatar-wrapper {
  padding: 0;
  width: 160rpx !important;
  height: 160rpx !important;
  border-radius: 50%;
  margin-bottom: 20rpx;
  background-color: #fff;
  position: relative;
  overflow: visible;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
}

.edit-icon {
  position: absolute;
  bottom: 0;
  right: 0;
  background: rgba(0,0,0,0.5);
  /* 尺寸与颜色交给 nqx-icon（size="16" color="#ffffff"），
     这里只负责把它钉在头像右下角那个半透明圆底上 */
  padding: 8rpx;
  border-radius: 50%;
}

.tip {
  font-size: 24rpx;
  color: #999;
}

.form-group {
  background: #fff;
  padding: 30rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  margin-bottom: 60rpx;
}

.label {
  font-size: 30rpx;
  color: #333;
  width: 120rpx;
}

.input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.save-btn {
  background: #07c160;
  color: #fff;
  border-radius: 40rpx;
  font-size: 32rpx;
  padding: 20rpx 0;
  width: 100%;
}

.save-btn:active {
  opacity: 0.9;
}
