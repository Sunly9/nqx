.container {
  min-height: 100vh;
  background: #f8f8f8;
  padding-bottom: 60rpx;
}

.header {
  background: #fff;
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
}

.faq-list {
  padding: 0 30rpx;
}

.faq-item {
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  /* 移除高度过渡动画，或者设置固定高度，这里直接去掉可能引起闪烁的属性 */
  transition: all 0.3s ease; 
}

.question {
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.arrow {
  color: #ccc;
  font-size: 24rpx;
  transition: transform 0.3s;
}

.arrow.open {
  transform: rotate(180deg);
}

.answer {
  padding: 0 30rpx 30rpx;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  border-top: 1rpx solid #f5f5f5;
  padding-top: 20rpx;
}

.contact-section {
  margin-top: 60rpx;
  padding: 0 30rpx;
  text-align: center;
}

.contact-tip {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 20rpx;
}

/* 覆盖按钮默认样式，使其融入列表 */
.contact-btn {
  background: #fff !important;
  border-radius: 0;
  padding: 20rpx 0 !important;
  margin: 0 !important;
  width: 100% !important;
  line-height: inherit;
  font-size: 28rpx;
  text-align: left;
  /* 强制 Flex 布局 */
  display: flex !important;
  justify-content: space-between !important;
  align-items: center !important;
}

.contact-btn::after {
  border: none;
}

.more-contact {
  margin-top: 20rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 0 30rpx;
}

.contact-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 28rpx;
}

.contact-row:last-child {
  border-bottom: none;
}

.contact-row .label {
  color: #666;
}

.contact-row .value {
  color: #07c160;
  font-weight: 500;
}
