<?xml version="1.0" encoding="UTF-8"?>
<!--
  nqx-web — 启动模块（Web 层）
  ============================================================================
  职责：Controller、启动类、Web 配置（拦截器/跨域/接口文档/线程池）、
        数据库迁移脚本（Flyway）、application.yml
  依赖：nqx-service
  注意：只有本模块打包为可执行 jar，故 spring-boot-maven-plugin 只在此声明
  ============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.nqx</groupId>
        <artifactId>nqx-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>nqx-web</artifactId>
    <name>nqx-web</name>
    <description>启动模块：Controller + 配置 + 启动类</description>

    <dependencies>
        <dependency>
            <groupId>com.nqx</groupId>
            <artifactId>nqx-service</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 健康检查端点，便于 Docker Compose 的 healthcheck -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ==================== 接口文档 ==================== -->
        <!-- 绝不可引入 Knife4j：它在 Boot 3.5 上运行期抛 NoSuchMethodError，
             且 4.5.0 为末版无修复。详见 docs/04-依赖版本锁定.md §3.1 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- ==================== 数据库 ==================== -->
        <!-- Flyway 管理 DDL 版本：V1__init_schema.sql / V2__init_data.sql -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- MySQL 方言支持，Flyway 10+ 起必须单独引入，否则启动报
             "Unsupported Database: MySQL" -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ==================== 测试 ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>nqx</finalName>
        <plugins>
            <!-- 只有启动模块需要 repackage 成可执行 jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.nqx.NqxApplication</mainClass>
                    <excludes>
                        <!-- Lombok 是编译期依赖，不应进入产物 -->
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
