# ============================================================================
#  本地环境变量（复制本文件为 local.env 后填写真实值）
# ============================================================================
#
#  用法：
#     copy config\local.env.example config\local.env
#     然后用记事本 / VS Code 打开 config\local.env 填真实值
#
#  ⚠️ config\local.env 已被 .gitignore 排除，不会被提交。
#     真实的 AppSecret 属于敏感凭证，绝对不能提交到仓库、也不能发到群里。
#
#  这些变量的读取者是 scripts\start-all.ps1：它会把每一行设成进程环境变量，
#  再由 Spring 的 ${WX_APP_ID:} 占位符注入到配置里（见 application.yml）。
# ============================================================================


# ---------------------------------------------------------------------------
#  微信小程序登录（决定是「真实微信用户」还是「模拟用户」）
# ---------------------------------------------------------------------------
#
#  不填 AppSecret 会发生什么：
#     服务端走 mock 分支，所有登录都映射到同一个固定 openid，
#     于是不管你用哪个微信号登录，看到的都是同一个账号（「演示用户」）。
#     日志里会出现：[开发模式] 未配置微信参数，使用模拟 openid 登录
#
#  填了 AppSecret 之后：
#     wx.login 拿到的 code 会去调微信的 jscode2session 换取真实 openid，
#     第一次登录创建真实用户，之后每次登录都是同一个真实用户。
#
#  从哪里拿这两个值：
#     微信公众平台 → 小程序 → 开发 → 开发管理 → 开发设置 → 开发者ID
#       · AppID     ：appid 那一行（本项目 project.config.json 里已填 wx0000000000000000）
#       · AppSecret ：点「重置」或「生成」拿到。只显示一次，务必抄下来存好
#
#  安全提醒：
#     · AppSecret 泄露 = 别人能冒充你的小程序去换 openid，必须当密码对待；
#     · 如果不小心泄露到公开仓库，立刻去公众平台重置，别犹豫。
#
#  AppID 一般和 project.config.json 里的一致，原样抄过来即可。
WX_APP_ID=wx0000000000000000

# 把下面的 xxxxxxxx 换成真实的 AppSecret（32 位十六进制字符串）
# 留空或保留 xxxxxxxx 时，脚本会提示「当前是模拟登录」
WX_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ---------------------------------------------------------------------------
#  可选：数据库 / Redis 连接（默认值与你本机现状一致，一般不用改）
# ---------------------------------------------------------------------------
#  对应 application-dev.yml 里的 ${DB_xxx:默认值} 占位符。
#  只有当你本机的 MySQL 密码不是 123456、或不在默认端口时才需要填。
#
#  DB_HOST=localhost
#  DB_PORT=3306
#  DB_NAME=nqx
#  DB_PASSWORD=123456
#
#  Redis 同理（REDIS_HOST / REDIS_PORT / REDIS_PASSWORD）
