# ============================================================================
# Git 属性：统一换行符与二进制识别
# ----------------------------------------------------------------------------
# 目的：不管谁在什么系统上 clone，Windows 脚本都能直接双击运行，
#       而图片/压缩包不会被当成文本做换行转换（那会把文件弄坏）。
# ============================================================================

# 默认按文本处理，入库统一 LF
* text=auto

# Windows 原生脚本必须保持 CRLF，否则 cmd 解析 .bat 可能出错
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.psm1  text eol=crlf

# 二进制：禁止任何换行符转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.jar   binary
*.zip   binary
*.woff  binary
*.woff2 binary
*.ttf   binary

# GitHub 语言统计：把 SQL 和文档单独归类，避免被当作"其他"
*.sql linguist-language=SQL
docs/** -linguist-detectable
