<?xml version="1.0" encoding="UTF-8"?>
<!--
  纽启新生 (NQX) — 父 POM
  ============================================================================
  依赖方向（严格单向，禁止反向依赖，否则 Maven 循环依赖直接构建失败）：
      nqx-web  →  nqx-service  →  nqx-mapper  →  nqx-pojo  →  nqx-common

  版本号全部经过 Maven Central 元数据核实，依据见 docs/04-依赖版本锁定.md。
  ============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 Spring Boot 官方父 POM：获得全部依赖的版本仲裁与插件默认配置 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.nqx</groupId>
    <artifactId>nqx-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>nqx-parent</name>
    <description>纽启新生 - 高校实验室纽扣电池回收与采购管理平台</description>

    <modules>
        <module>nqx-common</module>
        <module>nqx-pojo</module>
        <module>nqx-mapper</module>
        <module>nqx-service</module>
        <module>nqx-web</module>
    </modules>

    <properties>
        <!-- 必须是 17：SpringBoot 3.x 的基线版本，生态验证最充分。
             JDK 18 已 EOL，21/26 的三方适配不如 17。详见 docs/01 §2 -->
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 三方依赖版本（均已核实，勿随意改动，改动前请重跑 docs/04 §5 验证清单） -->
        <mybatis-plus.version>3.5.16</mybatis-plus.version>
        <sa-token.version>1.44.0</sa-token.version>
        <springdoc.version>2.8.17</springdoc.version>
        <redisson.version>3.52.0</redisson.version>
        <hutool.version>5.8.48</hutool.version>
        <fastexcel.version>1.3.0</fastexcel.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok.version>1.18.46</lombok.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- ==================== 内部模块 ==================== -->
            <dependency>
                <groupId>com.nqx</groupId>
                <artifactId>nqx-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nqx</groupId>
                <artifactId>nqx-pojo</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nqx</groupId>
                <artifactId>nqx-mapper</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nqx</groupId>
                <artifactId>nqx-service</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ==================== 持久层 ==================== -->
            <!-- 注意：必须用 spring-boot3 专用 starter。
                 mybatis-plus-boot-starter 是给 SpringBoot 2 用的，引错会启动失败 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!--
              分页插件运行期必需！
              MyBatis-Plus 自 3.5.9 起把 JSqlParser 从核心包中剥离为可选依赖，
              starter 的 pom 里已确认不再包含它。缺失时 PaginationInnerInterceptor
              在运行期抛 NoClassDefFoundError: net/sf/jsqlparser/...（编译期不报错）
            -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- ==================== 权限 ==================== -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot3-starter</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <!-- Sa-Token 会话存 Redis：多实例部署共享登录态 -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-redis-jackson</artifactId>
                <version>${sa-token.version}</version>
            </dependency>

            <!-- ==================== 接口文档 ==================== -->
            <!-- 不要换成 Knife4j！它在 Boot 3.5 上运行期抛 NoSuchMethodError，
                 且 4.5.0 是末版无修复。详见 docs/04 §3.1 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- ==================== 分布式锁 ==================== -->
            <!-- 3.51.0~3.52.0 官方针对 Boot 3.5.5 构建，捆绑 redisson-spring-data-35，
                 默认即正确，无需 exclusion。误用 4.x 会启动 NoClassDefFoundError -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>

            <!-- ==================== 工具 ==================== -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- ==================== Excel 导出 ==================== -->
            <!-- EasyExcel(com.alibaba) 已于 2024-09 停更，改用原班人马的续作 -->
            <dependency>
                <groupId>cn.idev.excel</groupId>
                <artifactId>fastexcel</artifactId>
                <version>${fastexcel.version}</version>
            </dependency>

            <!-- ==================== 对象映射 ==================== -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <!-- MapStruct 与 Lombok 协同的桥梁。缺了它 MapStruct 看不到
                 Lombok 生成的 getter/setter，会**静默生成空实现**
                 （编译通过但转换结果全是 null），是最难排查的一类问题 -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok-mapstruct-binding</artifactId>
                <version>${lombok-mapstruct-binding.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
      所有模块共用的依赖。Lombok 是编译期注解处理器，scope 必须是 provided，
      否则会被打进产物 jar（虽然运行时无害，但属于明确的打包污染）。
    -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <!-- 保留方法参数名，MyBatis 的 #{} 与 Spring 的 @PathVariable 都依赖它 -->
                        <parameters>true</parameters>
                        <!--
                          注解处理器顺序**不可颠倒**：
                            1. Lombok            —— 先生成 getter/setter
                            2. lombok-mapstruct-binding —— 让 MapStruct 能看到上一步的产物
                            3. MapStruct         —— 最后生成转换实现类
                          顺序错会导致 MapStruct 生成空实现，且编译期不报错
                        -->
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok-mapstruct-binding</artifactId>
                                <version>${lombok-mapstruct-binding.version}</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                        </annotationProcessorPaths>
                        <!--
                          刻意不在这里传 -Amapstruct.defaultComponentModel=spring。
                          原因是全局注解选项会让**没有使用 MapStruct 的模块**也产生
                          「注释选项未识别任何处理器」警告，污染构建输出。
                          改为在每个 @Mapper 接口上显式写 componentModel = "spring"，
                          更明确，也便于逐个调整。
                        -->
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
