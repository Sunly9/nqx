<?xml version="1.0" encoding="UTF-8"?>
<!--
  nqx-mapper — 数据访问层
  ============================================================================
  职责：Mapper 接口 + resources/mapper/*.xml（复杂动态 SQL 手写在此）
  依赖：nqx-pojo
  原则：单表 CRUD 交给 MyBatis-Plus 提效；后台多条件检索、聚合统计一律手写 XML，
        因为 Wrapper 在多层嵌套条件与聚合函数下可读性急剧下降，且 SQL 不透明
  ============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.nqx</groupId>
        <artifactId>nqx-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>nqx-mapper</artifactId>
    <name>nqx-mapper</name>
    <description>数据访问层：Mapper 接口 + XML</description>

    <dependencies>
        <dependency>
            <groupId>com.nqx</groupId>
            <artifactId>nqx-pojo</artifactId>
        </dependency>

        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- 分页插件 PaginationInnerInterceptor 的运行期依赖，务必保留 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
    </dependencies>
</project>
