# ============================================================================
# 环境变量模板
# ----------------------------------------------------------------------------
# 使用：cp .env.example .env   然后按需修改
#
# 【重要】不要把 .env 提交进 Git —— 它包含真实密码。
#         .gitignore 已将其排除。
# ============================================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=123456
MYSQL_PORT=3306

# ---------- Redis ----------
REDIS_PASSWORD=123456
REDIS_PORT=6379

# ---------- 应用 ----------
APP_PORT=8080

# 演示环境建议开 true 以便访问 /swagger-ui.html；
# 对外正式部署务必改为 false，避免暴露全部接口结构
SPRINGDOC_ENABLED=true

# ---------- 初始管理员 ----------
# 仅在 sys_user 表为空时生效（首次启动创建一次）
# 首次登录后请立即修改密码
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=Admin@123

# ---------- 微信小程序（可选） ----------
# 不填则小程序登录接口不可用，但不影响后台管理功能
WX_APP_ID=
WX_APP_SECRET=
WX_ORDER_TEMPLATE_ID=

# ---------- 文件存储 ----------
# 容器环境的磁盘是临时的，用户上传的图片（头像/评价晒图/维修凭证）必须放对象存储。
#
#   cos   → 腾讯云 COS（默认，容器部署用这个）
#   local → 本地磁盘 ./uploads（仅当 upload-data 卷确实持久化时才可接受）
UPLOAD_TYPE=cos

# 腾讯云 COS 参数（UPLOAD_TYPE=cos 时必填，否则启动直接失败）
#
# ⚠️ 请用【子账号】密钥，只授权这一个桶的 uploads/ 前缀读写，不要用主账号密钥。
#    子账号创建：腾讯云 → 访问管理 CAM → 用户 → 新建用户（编程访问）→ 关联策略
#
# 桶名必须带 APPID 后缀，形如 nqx-1300000000
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-shanghai
COS_BUCKET=
# 桶内前缀，把程序上传的文件与手工素材分开
COS_KEY_PREFIX=uploads
# 可选：绑定了 CDN / 自定义域名时填这里，返回的 URL 会走该域名
COS_DOMAIN=
