# ============================================================================
# 纽启新生 (NQX) — Git 忽略规则
# ============================================================================

# ---------- 构建产物 ----------
target/
build/
out/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar

# ---------- IDE ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
.factorypath

# ---------- 运行期文件 ----------
logs/
*.log
uploads/
*.pid

# ---------- 前端 ----------
node_modules/
dist/
dist-ssr/
.vite/
.pnpm-debug.log*
npm-debug.log*
yarn-error.log*
package-lock.json
pnpm-lock.yaml
yarn.lock

# ---------- 小程序 ----------
nqx-miniprogram/node_modules/
nqx-miniprogram/miniprogram_npm/

# ---------- 数据库本地数据 ----------
*.sql.gz
*.dump
*.bak

# ---------- 敏感信息 ----------
# 真实环境配置绝不入库，只提交 *.example 模板
application-local.yml
application-secret.yml
.env
.env.local
*.pem
*.p12
*.jks

# ---------- 系统文件 ----------
.DS_Store
Thumbs.db
desktop.ini

# 数据库备份（含全部业务数据，绝不入库）
backup/

# 本地环境变量（含微信 AppSecret 等敏感凭证，不提交）
config/local.env
!config/local.env.example

# ---------- 敏感文件补充（.env.bak-时间戳 这类备份不会被 *.bak 匹配到）----------
.env.bak-*

# ---------- 部署包与本地工具（体积大，与源码无关，不入库）----------
*.zip
tools/